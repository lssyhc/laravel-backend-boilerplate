{
    "name": "be-laravel",
    "private": true,
    "scripts": {
        "prepare": "husky",
        "format": "php ./vendor/bin/pint"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0"
    },
    "lint-staged": {
        "**/*.php": [
            "./vendor/bin/pint"
        ],
        "app/**/*.php": [
            "./vendor/bin/phpstan analyse --memory-limit=2G"
        ]
    }
}

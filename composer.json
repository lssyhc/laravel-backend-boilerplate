{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "license": "proprietary",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "node -e \"const { spawn } = require('node:child_process'); const isWindows = process.platform === 'win32'; const children = []; let stopped = false; const killChildren = () => { for (const child of children) { if (child && !child.killed) { child.kill('SIGTERM'); } } }; const forward = (label, stream, chunk) => { process.stdout.write('[' + label + '] ' + chunk.toString()); }; const start = (label, args) => { const child = spawn('php', args, { stdio: ['ignore', 'pipe', 'pipe'], windowsHide: true }); children.push(child); child.stdout.on('data', (chunk) => forward(label, child.stdout, chunk)); child.stderr.on('data', (chunk) => forward(label, child.stderr, chunk)); child.on('exit', (code) => { if (stopped) { return; } if (code && code !== 0) { stopped = true; killChildren(); process.exit(code); } }); return child; }; process.on('SIGINT', () => { stopped = true; killChildren(); process.exit(0); }); process.on('SIGTERM', () => { stopped = true; killChildren(); process.exit(0); }); start('server', ['artisan', 'serve']); start('queue', ['artisan', 'queue:listen', '--tries=1', '--timeout=0']); if (!isWindows) { start('logs', ['artisan', 'pail', '--timeout=0']); } setInterval(() => {}, 1000);\""
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --env=test"
        ],
        "migrate:dev": [
            "@php artisan migrate"
        ],
        "migrate:test": [
            "@php artisan migrate --env=test"
        ],
        "migrate:fresh:dev": [
            "@php artisan migrate:fresh"
        ],
        "migrate:fresh:test": [
            "@php artisan migrate:fresh --env=test"
        ],
        "migrate:status:dev": [
            "@php artisan migrate:status"
        ],
        "migrate:status:test": [
            "@php artisan migrate:status --env=test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [ ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
